+def managed_code(selected):
+    """Only the fixed protected root-managed binding may traverse a symlink."""
+    path = Path(selected)
+    if path != MANAGED_LINK or not path.is_symlink():
+        raise ValueError('Expected managed worker binding')
+    info = path.lstat()
+    resolved = path.resolve(strict=True)
+    if (info.st_uid != ROOT_UID or resolved.parent != MANAGED_ROOT/'releases'
+            or not re.fullmatch('[a-f0-9]{64}', resolved.name)):
+        raise ValueError('Unexpected managed worker release')
+    for directory in (path.parent, *path.parent.parents, resolved, *resolved.parents):
+        info = directory.lstat()
+        if not stat.S_ISDIR(info.st_mode) or info.st_uid != ROOT_UID or info.st_mode & 0o022:
+            raise ValueError('Unprotected managed binding ancestor')
+    current = read_json(root_file(MANAGED_ROOT/'current.json'))
+    if current.get('release') != resolved.name:
+        raise ValueError('Managed binding/current generation disagree')
+    if Path(__file__).resolve().parents[2] != resolved:
+        raise ValueError('Worker entry point differs from managed generation')
+    return resolved
+
+
+def integration_intake(state):
+    """A root-created clean slot is consumed; dirty/uncertain evidence refuses."""
+    directory = Path(state)/'last-integration'
+    if not directory.exists() and not directory.is_symlink():
+        return
+    if directory.is_symlink() or not directory.is_dir():
+        raise ValueError('Unexpected integration slot')
+    if {p.name for p in directory.iterdir()} == {FRESH_MARKER}:
+        marker = directory/FRESH_MARKER
+        info = marker.lstat()
+        if (not stat.S_ISREG(info.st_mode) or info.st_uid != ROOT_UID
+                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o644):
+            raise ValueError('Untrusted integration clean-slot marker')
+        data = read_json(marker, limit=512)
+        if (set(data) != {'version','workspace','generation'} or data['version'] != 1
+                or data['workspace'] != str(directory) or type(data['generation']) is not int
+                or data['generation'] < 1):
+            raise ValueError('Invalid integration clean-slot marker')
+        marker.unlink()
+        directory.rmdir()
+        fd = os.open(state, os.O_RDONLY|os.O_DIRECTORY)
+        try: os.fsync(fd)
+        finally: os.close(fd)
+        return
+    from integration_artifacts import retained
+    _, receipt = retained(directory)
+    if receipt['original_transfer'] != 'durable':
+        raise ValueError('integration-previous-transfer-uncertain')
 
 
