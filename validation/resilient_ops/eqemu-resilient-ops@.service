[Unit]
Description=Resilient operations connection

[Service]
Type=exec
ExecStart=/usr/bin/python3 -I -c "import os,runpy; runpy.run_path(os.path.realpath('/usr/lib/eqemu-resilient-ops/current/service.py'),run_name='__main__')"
StandardInput=socket
StandardOutput=socket
StandardError=journal
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LimitNOFILE=256
MemoryMax=256M
TasksMax=64
