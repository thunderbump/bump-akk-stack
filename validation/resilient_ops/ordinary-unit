[Unit]
Description=Unprivileged EQEmu validation connection
CollectMode=inactive-or-failed

[Service]
User=eqemu-validator
Group=eqemu-validator
SupplementaryGroups=kvm
ExecStart=/usr/bin/python3 -I /srv/eqemu-validator-code/validation/worker/runtime.py serve --config /etc/eqemu-validator/config.json
ExecStopPost=/usr/bin/python3 -I /srv/eqemu-validator-code/validation/worker/runtime.py cleanup --config /etc/eqemu-validator/config.json
StandardInput=socket
StandardOutput=socket
StandardError=journal
WorkingDirectory=/var/lib/eqemu-validator/ordinary
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/eqemu-validator/ordinary /var/lib/eqemu-validator/worker.lock
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
AppArmorProfile=eqemu-validator
MemoryMax=6G
MemorySwapMax=0
TasksMax=64
CPUQuota=200%
LimitNOFILE=256
RuntimeMaxSec=18360
TimeoutStopSec=15
KillMode=control-group
SendSIGKILL=yes
