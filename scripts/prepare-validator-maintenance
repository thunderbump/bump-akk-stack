#!/usr/bin/python3 -I
"""Build finite root maintenance package as data only; no service invocation."""
import sys
sys.dont_write_bytecode = True
import argparse, base64, grp, hashlib, json, os, pwd, shlex, stat, subprocess
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
SOURCE=ROOT/'validation/maintenance'
sys.path.insert(0,str(SOURCE))
from maintenance import canonical, FIXTURE, RELEASE, CODE, metadata


def public(path):
    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
    try:
        info=os.fstat(fd);assert stat.S_ISREG(info.st_mode) and info.st_size<=1048576
        raw=os.pread(fd,1048577,0)
        keys=('st_dev','st_ino','st_uid','st_gid','st_mode','st_size','st_mtime_ns','st_ctime_ns')
        assert len(raw)==info.st_size and all(getattr(info,k)==getattr(os.fstat(fd),k)==getattr(path.lstat(),k) for k in keys)
        return raw,dict(metadata(info),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
    finally:os.close(fd)


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output',type=Path,required=True)
    parser.add_argument('--submitter',default='bump')
    args=parser.parse_args()
    assert not subprocess.check_output(['/usr/bin/git','-C',str(ROOT),'status','--porcelain=v1'])
    user=pwd.getpwnam(args.submitter);grp.getgrgid(user.pw_gid)
    release,record=public(CODE/RELEASE);value=json.loads(release)
    assert value['schema']==1 and value['selection']=='central-cdau-integration-v1'
    names=set(value['files'])|{RELEASE}
    assert len(names)==19
    records={name:public(CODE/name)[1] for name in names}
    for name,wanted in value['files'].items():assert all(records[name][k]==v for k,v in wanted.items())
    for directory in (CODE,CODE/'validation',CODE/'validation/worker'):
        info=directory.lstat();assert (info.st_uid,info.st_gid,stat.S_IMODE(info.st_mode))==(0,0,0o755) and stat.S_ISDIR(info.st_mode)
    fixture=public(CODE/FIXTURE)[0]
    policies={str(path):public(path)[1] for path in [Path('/etc/eqemu-validator/config.json'),Path('/etc/systemd/system/eqemu-validator.socket'),Path('/etc/systemd/system/eqemu-validator@.service'),Path('/etc/apparmor.d/eqemu-validator')]}
    assets={name:public(SOURCE/name)[0] for name in ['maintenance.py','service.py','install.py','eqemu-validator-maintenance.socket','eqemu-validator-maintenance@.service']}
    assets['eqemu-validator-maintenance.socket']=assets['eqemu-validator-maintenance.socket'].replace(b'@GROUP@',str(user.pw_gid).encode())
    monitored={str(CODE/'scripts'):metadata((CODE/'scripts').lstat())}
    assert stat.S_ISDIR((CODE/'scripts').lstat().st_mode)
    config=dict(monitored_directories=monitored,schema=1,submitter_uid=user.pw_uid,submitter_gid=user.pw_gid,records=records,policies=policies,fixture=base64.b64encode(fixture).decode(),release=base64.b64encode(release).decode(),code_sha256={name:hashlib.sha256(assets[name]).hexdigest() for name in ['maintenance.py','service.py','install.py']})
    assets['baseline.json']=canonical(config)
    output=args.output.absolute();output.mkdir(mode=0o700)
    manifest={}
    for name,raw in assets.items():
        with (output/name).open('xb') as stream:stream.write(raw)
        (output/name).chmod(0o400)
        manifest[name]=dict(bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
    raw=canonical(manifest);(output/'manifest.json').write_bytes(raw);(output/'manifest.json').chmod(0o400)
    digest=hashlib.sha256(raw).hexdigest();installer=manifest['install.py']['sha256']
    bootstrap="import os,hashlib;from pathlib import Path;p=Path("+repr(str(output/'install.py'))+");f=os.open(p,os.O_RDONLY|os.O_NOFOLLOW|os.O_NOATIME);i=os.fstat(f);b=os.pread(f,131073,0);assert len(b)==i.st_size and i==os.fstat(f) and i==p.lstat() and hashlib.sha256(b).hexdigest()=="+repr(installer)+";os.close(f);exec(compile(b,str(p),'exec'),{'__name__':'__main__','__file__':str(p)})"
    command=['/usr/bin/python3','-I','-S','-c',bootstrap,'--package',str(output),'--sha256',digest]
    print(json.dumps(dict(package=str(output),package_sha256=digest,installer_sha256=installer,install_argv=command+['install'],install_shell=shlex.join(command+['install']),resume_install_argv=command+['resume-install'],uninstall_argv=command+['uninstall'],worker_started=False),indent=2))

if __name__=='__main__':main()
