#!/usr/bin/env python3
"""Unprivileged client. Root installation uses only the reviewed staged operator."""
import importlib.util
from pathlib import Path

source = Path(__file__).resolve().parent.parent / 'validation/resilient_ops/client.py'
spec = importlib.util.spec_from_file_location('resilient_client', source)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
raise SystemExit(module.main())
