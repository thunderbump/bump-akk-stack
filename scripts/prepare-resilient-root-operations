#!/usr/bin/env python3
"""Create a review package and print exact commands. Makes no installed changes."""
import argparse
import importlib.util
import json
import subprocess
from pathlib import Path

source = Path(__file__).resolve().parent.parent / 'validation/resilient_ops'
spec = importlib.util.spec_from_file_location('resilient_package', source / 'package.py')
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--output', type=Path, required=True)
parser.add_argument('--policy', type=Path, help='Optional separately reviewed policy; never enrolled by preparation')
args = parser.parse_args()
checkout = source.parent.parent
def git(*argv):
    return subprocess.check_output(['git', '-C', str(checkout), *argv], text=True).strip()
if git('status', '--porcelain', '--untracked-files=all'):
    parser.error('clean committed checkout required; dirty or untracked assets rejected')
for name in module.ASSETS:
    git('ls-files', '--error-unmatch', str((source / name).relative_to(checkout)))
commit = git('rev-parse', '--verify', 'HEAD')
tree = git('rev-parse', 'HEAD^{tree}')
expected_assets = {}
for name in module.ASSETS:
    relative = str((source / name).relative_to(checkout))
    committed = subprocess.check_output(['git', '-C', str(checkout), 'cat-file', 'blob', commit + ':' + relative])
    expected_assets[name] = module.digest(committed)
result = module.prepare(source, args.output, args.policy, expected_assets)
result['source'] = {'commit': commit, 'tree': tree, 'observed_head': commit}
print(json.dumps(result, indent=2, sort_keys=True))
